# Gere cada segredo com: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CML_APP_SECRET=
CML_ADMIN_PASSWORD=
CML_INGEST_SECRET=
# Local: false. Produção HTTPS: true.
CML_COOKIE_SECURE=false
CML_DOMAIN=marketing.example.com
CML_CODEX_ENABLED=false
CML_CREATIVE_MODEL=gpt-6-sol
CML_CREATIVE_FALLBACK_MODEL=gpt-6.1-sol
CML_BLOG_CODEX_MODEL=gpt-6-sol
CML_BLOG_PUBLISH_ENABLED=false
CML_BLOG_SSH_HOST=
CML_BLOG_SSH_PORT=22
CML_BLOG_SSH_USER=
CML_BLOG_REMOTE_BLOG_DIR=
